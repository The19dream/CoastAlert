{
  "compilerOptions": {
    "target": "es2022",
    "module": "Node16",
    "lib": [
      "es2022",
      "dom"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true,
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ],
    "moduleResolution": "node16",
    "baseUrl": ".",
    "paths": {
      "@x402/avm/exact/server": [
        "node_modules/@x402/avm/dist/cjs/exact/server/index.d.ts"
      ],
      "@x402/core/server": [
        "node_modules/@x402/core/dist/cjs/server/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "seed.ts"
  ],
  "exclude": [
    "src/test-api.ts",
    "src/test-jwt-mongo.ts",
    "src/test-llm.ts",
    "whatsapp-test.js",
    "node_modules"
  ]
}
